# Get it at dev.meta.ai; put the real value in .env.local; never commit it.
MODEL_API_KEY=
# Auth: 32+ char secret and the app base URL; real values live in .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Open the dev server from a phone on the same Wi-Fi (optional): the Mac's
# name, and the same address with its port for sign-in.
# DEV_ALLOWED_ORIGINS=my-mac.local
# BETTER_AUTH_TRUSTED_ORIGINS=http://my-mac.local:3100
DATABASE_URL=file:./data/koblip-book.db

# Google login and Google Calendar (Google Cloud > Google Auth Platform >
# Clients, server only). Redirect URIs: <BETTER_AUTH_URL>/api/auth/callback/google
# and <BETTER_AUTH_URL>/api/google-calendar/callback; turn on the Google
# Calendar API (docs/plans/google-calendar.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google (search = Places API, server only)
GOOGLE_MAPS_PLATFORM_KEY=
# Google (map shown on the page)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Google map style (Map ID), from Google Cloud > Map Management
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Google Cloud Translation, server only (docs/plans/translations.md, G0): the
# project's ID, and the path to its service account's key file, kept outside
# the app folder. Empty = texts wait to be translated.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# "fake" marks texts with their language instead of translating them, for
# local work only (never used in production). Empty = Google.
TRANSLATION_PROVIDER=
# Folder for uploaded photos. Empty = ./data/uploads
UPLOADS_DIR=
# Email through Amazon SES's API (server only, docs/email.md). Empty = emails
# are skipped with a warning, which suits local work; a deploy stops without
# them (docs/deploy.md). The keys are a send-only IAM user's.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# "Koblip <contact@koblip.com>", quoted: it has a space.
EMAIL_FROM=
# The configuration set that sends each email's events to SNS, and that
# SNS topic's ARN, which /api/email/events accepts. Empty = no events.
SES_CONFIGURATION_SET=
SES_EVENTS_TOPIC_ARN=
# Spoken replies (server only). Keep the real value in .env.local.
ELEVENLABS_API_KEY=
# Koblip Chat connection (server only; docs/koblip-chat-integration.md).
# Client id and secret come from Koblip Chat's app registry. The redirect
# must match one registered there exactly.
CHAT_OAUTH_CLIENT_ID=
CHAT_OAUTH_CLIENT_SECRET=
CHAT_OAUTH_REDIRECT_URI=http://localhost:3100/api/chat/callback
CHAT_CONNECT_URL=https://chat.koblip.com/connect/koblip-book
CHAT_API_URL=https://api.koblip.com
# Checks Koblip Chat's signed events at /api/chat/events: the same secret as
# this app's entry in Chat's OAUTH_APP_EVENTS (at least 32 random bytes,
# openssl rand -hex 32), never the client secret.
CHAT_EVENTS_SECRET=
# Seals stored app tokens: 32 random bytes, base64 (openssl rand -base64 32).
TOKEN_ENCRYPTION_KEY=
# App subscriptions (docs/plans/subscriptions.md): Stripe Dashboard →
# Developers → API keys (test mode first), and the signing secret of the
# webhook <BETTER_AUTH_URL>/api/auth/stripe/webhook. Billing is off without both.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Online payments (docs/online-payments.md): the signing secret of the
# second webhook, <BETTER_AUTH_URL>/api/stripe/connect ("Connected
# accounts"). Card payments are off without it.
STRIPE_CONNECT_WEBHOOK_SECRET=

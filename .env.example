# Get it at dev.meta.ai; put the real value in .env.local; never commit it.
MODEL_API_KEY=
# Auth: 32+ char secret and the app base URL; real values live in .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
DATABASE_URL=file:./data/koblip-book.db

# Google login (Google Cloud > Google Auth Platform > Clients, server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google (search = Places API, server only)
GOOGLE_MAPS_PLATFORM_KEY=
# Google (map shown on the page)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Google map style (Map ID), from Google Cloud > Map Management
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Folder for uploaded photos. Empty = ./data/uploads
UPLOADS_DIR=
# Email (SMTP, server only). Empty = emails are skipped with a warning.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Spoken replies (server only). Keep the real value in .env.local.
ELEVENLABS_API_KEY=
# Koblip Chat connection (server only; docs/koblip-chat-integration.md).
# Client id and secret come from Koblip Chat's app registry. The redirect
# must match one registered there exactly.
CHAT_OAUTH_CLIENT_ID=
CHAT_OAUTH_CLIENT_SECRET=
CHAT_OAUTH_REDIRECT_URI=http://localhost:3100/api/chat/callback
CHAT_CONNECT_URL=https://chat.koblip.com/connect/koblip-book
CHAT_API_URL=https://api.koblip.com
# Seals stored app tokens: 32 random bytes, base64 (openssl rand -base64 32).
TOKEN_ENCRYPTION_KEY=

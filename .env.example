# Get it at dev.meta.ai; put the real value in .env.local; never commit it.
MODEL_API_KEY=
# Auth: 32+ char secret and the app base URL; real values live in .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
DATABASE_URL=file:./data/koblip-book.db

# Google (search = Places API, server only)
GOOGLE_MAPS_PLATFORM_KEY=
# Google (map shown on the page)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Google map style (Map ID), from Google Cloud > Map Management
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Folder for uploaded photos. Empty = ./data/uploads
UPLOADS_DIR=

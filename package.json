{
  "name": "koblip-book",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "deploy": "bash scripts/deploy.sh",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:place": "tsx --conditions=react-server scripts/import-place.ts",
    "about:write": "tsx --conditions=react-server scripts/write-about.ts",
    "customers:backfill": "tsx --conditions=react-server scripts/backfill-customer-keys.ts",
    "templates:remove-old": "tsx --conditions=react-server scripts/remove-old-templates.ts",
    "catalog:refill": "tsx --conditions=react-server scripts/refill-starter-catalogs.ts",
    "policies:fill": "tsx --conditions=react-server scripts/fill-policies.ts",
    "category:fix": "tsx --conditions=react-server scripts/fix-categories.ts",
    "i18n:check": "tsx --conditions=react-server scripts/i18n-check.ts",
    "translations:backfill": "tsx --conditions=react-server scripts/translations-backfill.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/stripe": "^1.7.18",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@google-cloud/translate": "^10.3.0",
    "@libsql/client": "^0.18.0",
    "@mynaui/icons-react": "^0.4.11",
    "@paper-design/shaders-react": "^0.0.82",
    "@radix-ui/react-slider": "^1.6.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "@types/three": "^0.187.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@xyflow/react": "^12.12.1",
    "better-auth": "^1.7.18",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cldr-core": "49.0.0",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "countries-and-timezones": "^3.11.0",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "input-otp": "^1.5.0",
    "lenis": "^1.3.26",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.61.0",
    "motion": "^14.7.1",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "openai": "^7.45.0",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "recharts": "^3.8.0",
